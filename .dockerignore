# Build context for deploy/*.Dockerfile is the repo root. Without this the
# daemon would ship node_modules, the vector store and local media on every
# build.
.git
.github
.claude
.codex

**/node_modules
**/__pycache__
**/*.pyc
**/.pytest_cache

# Secrets never belong in an image layer; compose injects env at runtime.
.env
.env.*
!.env.example
deploy/.env.prod

# Local build output — the images build their own.
frontend/build
backend/staticfiles
backend/media
backend/chroma_db
backend/db.sqlite3
**/*.log

# Docs and one-off scripts, none of which the runtime needs.
*.md
!README.md
marketing
mobile
