# Knoledgr production environment. Copy to deploy/.env.prod on the VPS and
# fill in the secrets — .env.prod is gitignored and must never be committed.
#
# Consumed twice: compose interpolates the build/infra values, and every
# backend container gets the whole file via env_file.

# ---- Django core ------------------------------------------------------------
SECRET_KEY=CHANGE_ME
DEBUG=False

# Hostnames Django will answer to. The edge proxies all three here.
ALLOWED_HOSTS=knoledgr.com,www.knoledgr.com,api.knoledgr.com
# Render-era wildcard default; nothing on this box is a .onrender.com host.
EXTRA_ALLOWED_HOSTS=

# ---- Datastores (in-stack, not Neon/Upstash any more) -----------------------
# POSTGRES_* build the db container; DATABASE_URL is what Django reads. Keep
# the password identical in both.
POSTGRES_DB=knoledgr
POSTGRES_USER=knoledgr
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://knoledgr:CHANGE_ME@db:5432/knoledgr

# Plain redis:// on the internal network — the rediss:// branch in settings.py
# exists only for Upstash and is no longer taken.
REDIS_URL=redis://redis:6379/0

# ---- Origins ----------------------------------------------------------------
# The SPA is served same-origin with the API, so CORS is effectively unused by
# the web app; these cover api.knoledgr.com and the mobile client.
FRONTEND_URL=https://knoledgr.com
PUBLIC_API_URL=https://knoledgr.com
CORS_ALLOWED_ORIGINS=https://knoledgr.com,https://www.knoledgr.com
CSRF_TRUSTED_ORIGINS=https://knoledgr.com,https://www.knoledgr.com,https://api.knoledgr.com

# ---- Frontend build args (compile-time, inlined into the CRA bundle) ---------
REACT_APP_API_URL=https://knoledgr.com
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENVIRONMENT=production
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.1
REACT_APP_TURNSTILE_SITE_KEY=

# ---- Background work --------------------------------------------------------
NOTIFICATIONS_USE_CELERY=True

# ---- Paths ------------------------------------------------------------------
# settings.py defaults these to Windows paths from local development; they must
# be overridden inside the containers.
CHROMA_PERSIST_DIRECTORY=/app/chroma_db
TRANSFORMERS_CACHE=/app/.cache/transformers
HUGGINGFACE_HUB_CACHE=/app/.cache/huggingface
TEMP_DIR=/tmp

# ---- Email ------------------------------------------------------------------
RESEND_API_KEY=
DEFAULT_FROM_EMAIL="Knoledgr <noreply@knoledgr.com>"
SUPPORT_EMAIL=

# ---- Media (Cloudinary) ------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- AI ---------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- Auth providers (Google OAuth; AWS Cognito removed) ---------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Bot protection ---------------------------------------------------------
TURNSTILE_ENABLED=True
TURNSTILE_SECRET_KEY=

# ---- Observability ----------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Optional integrations (leave blank to keep the feature offline) --------
# GitHub App endpoints return 503 until all four are set.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
CALENDAR_OAUTH_REDIRECT_URI=
